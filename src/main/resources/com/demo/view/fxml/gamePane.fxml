<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="main-background" stylesheets="@../css/gamePane.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.demo.controller.GamePaneController">


    <!--  Header -->
    <top>
        <StackPane prefHeight="80.0" prefWidth="958.0" styleClass="header-container">
            <Label fx:id="gameTitle" styleClass="game-title" text="ARKANOID" />
            <BorderPane.margin>
                <Insets left="5.0" right="5.0" top="5.0" />
            </BorderPane.margin>
        </StackPane>
    </top>

    <!-- Main Content Area -->
    <center>
        <HBox prefHeight="502.0" spacing="10.0" styleClass="game-content">

            <!-- Left Panel - Chiếm phần còn lại -->
            <VBox spacing="15.0" styleClass="side-panel" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>

                <!-- Credits Section -->
                <VBox alignment="CENTER" styleClass="panel-section">
                    <Label prefHeight="36.0" prefWidth="117.0" styleClass="panel-header" text="HIGHSCORE">
                        <VBox.margin>
                            <Insets bottom="20.0" top="50.0" />
                        </VBox.margin>
                    </Label>
                    <Label fx:id="highScoreLabel" styleClass="panel-value" text="0" />
                </VBox>

                <!-- Left Stats -->
                <VBox alignment="CENTER" styleClass="panel-section" />

                <VBox styleClass="panel-section" />

                <VBox styleClass="panel-section" />

                <VBox styleClass="panel-section" />

                <VBox styleClass="panel-section" />

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- Game Canvas Area - Cố định chiều rộng -->
            <StackPane fx:id="gameArea" maxWidth="900" minWidth="900" prefWidth="900" styleClass="game-area">
                <Canvas fx:id="gameCanvas" width="900" />

                <!-- Game Status Overlay -->
                <VBox fx:id="gameStatusOverlay" alignment="CENTER" spacing="20.0" styleClass="game-overlay" visible="false">
                    <Label fx:id="gameStatusLabel" styleClass="status-text" text="GAME OVER" />
                    <Button fx:id="restartButton" onAction="#restartGame" styleClass="overlay-button" text="RESTART" />
                </VBox>
            </StackPane>

            <!-- Right Panel - Chiếm phần còn lại -->
            <VBox spacing="15.0" styleClass="side-panel" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="50.0" />
                </padding>

                <!-- Score Section -->
                <VBox alignment="TOP_CENTER" prefHeight="250.0" prefWidth="166.0" styleClass="panel-section">
                    <Label prefHeight="36.0" prefWidth="102.0" styleClass="panel-header" text="SCORE" />
                    <Label fx:id="scoreLabel" minHeight="35.0" prefHeight="35.0" prefWidth="84.0" styleClass="panel-value" text="0" />
                </VBox>

                <!-- Right Stats -->
                <VBox styleClass="panel-section" />

                <VBox styleClass="panel-section" />

                <!-- Level Section -->
                <VBox alignment="CENTER" styleClass="panel-section">
                    <Label prefHeight="36.0" prefWidth="121.0" styleClass="panel-header" text="LEVEL" />
                    <Label fx:id="levelLabel" prefHeight="40.0" prefWidth="70.0" styleClass="panel-value-small" text="1" />
                </VBox>

                <!-- Lives Section -->
                <VBox alignment="CENTER" styleClass="panel-section">
                    <Label prefHeight="36.0" prefWidth="113.0" styleClass="panel-header" text="LIVES" />
                    <HBox fx:id="livesContainer" alignment="CENTER" spacing="5.0" styleClass="lives-display">
                        <Label styleClass="heart" text="♥" />
                        <Label styleClass="heart" text="♥" />
                        <Label styleClass="heart" text="♥" />
                    </HBox>
                </VBox>
            </VBox>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </center>

    <!-- Bottom Controls -->
    <bottom>
        <HBox alignment="CENTER" maxHeight="116.0" minHeight="87.0" prefHeight="116.0" prefWidth="1050.0" spacing="20.0" styleClass="bottom-controls">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <!-- Left Control Group -->
            <HBox spacing="10.0">
                <Button fx:id="returnButton" onAction="#returnGame" prefHeight="44.0" prefWidth="123.0" styleClass="return-button" text="RETURN">
                    <HBox.margin>
                        <Insets left="40.0" />
                    </HBox.margin></Button>
            </HBox>


            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Right Control Group -->
            <HBox prefHeight="94.0" prefWidth="329.0" spacing="10.0">
                <Button fx:id="startButton" onAction="#startGame" prefHeight="44.0" prefWidth="180.0" styleClass="start-button" text="START" />
                <Button fx:id="pauseButton" onAction="#pauseGame" styleClass="control-button" text="PAUSE" />
            </HBox>
            <BorderPane.margin>
                <Insets bottom="10.0" />
            </BorderPane.margin>
        </HBox>
    </bottom>
</BorderPane>
