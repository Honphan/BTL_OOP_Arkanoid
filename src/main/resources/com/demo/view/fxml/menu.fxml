<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Polygon?>
<?import java.lang.Double?>



<StackPane prefHeight="700" prefWidth="600" styleClass="main-background" stylesheets="@../css/menu.css"
           xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.demo.controller.menuController">

    <VBox alignment="CENTER" spacing="30.0">
        <padding>
            <Insets top="40" bottom="40" left="40" right="40"/>
        </padding>

        <!-- Title -->
        <Label styleClass="game-title" text="ARKANOID">
            <VBox.margin>
                <Insets top="40"/>
            </VBox.margin>
        </Label>


        <!-- Level Selection Container -->
        <VBox alignment="CENTER" spacing="15" styleClass="level-selection-container">
            <padding>
                <Insets top="20" bottom="20" left="30" right="30"/>
            </padding>

            <!-- Level Number Label -->
            <Label fx:id="levelNumberLabel" styleClass="level-number-label" text="LEVEL 1"/>

            <!-- Level Preview with Arrows -->
            <HBox alignment="CENTER" spacing="30">
                <!-- Left Arrow -->
                <StackPane fx:id="leftArrowButton" styleClass="arrow-button">
                    <Polygon styleClass="arrow-shape">
                        <points>
                            <Double fx:value="25.0"/>
                            <Double fx:value="15.0"/>
                            <Double fx:value="15.0"/>
                            <Double fx:value="25.0"/>
                            <Double fx:value="25.0"/>
                            <Double fx:value="35.0"/>
                        </points>
                    </Polygon>
                </StackPane>

                <!-- Level Preview Image Container -->
                <StackPane styleClass="image-container" prefHeight="320" prefWidth="440">
                    <!-- Border/Frame -->
                    <Rectangle arcHeight="20" arcWidth="20" height="300" width="420"
                               styleClass="image-border"/>

                    <!-- Level Preview Image -->
                    <ImageView fx:id="levelPreviewImage"
                               fitHeight="280"
                               fitWidth="400"
                               preserveRatio="false"
                               styleClass="level-preview-image">
                        <StackPane.margin>
                            <Insets top="10" bottom="10" left="10" right="10"/>
                        </StackPane.margin>
                    </ImageView>
                </StackPane>

                <!-- Right Arrow -->
                <StackPane fx:id="rightArrowButton" styleClass="arrow-button">
                    <Polygon styleClass="arrow-shape">
                        <points>
                            <Double fx:value="15.0"/>
                            <Double fx:value="15.0"/>
                            <Double fx:value="25.0"/>
                            <Double fx:value="25.0"/>
                            <Double fx:value="15.0"/>
                            <Double fx:value="35.0"/>
                        </points>
                    </Polygon>
                </StackPane>
            </HBox>

            <!-- Level Description -->
            <Label styleClass="level-description" text="Select your level and click START">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Label>
        </VBox>

        <!-- Buttons -->
        <VBox alignment="CENTER" spacing="15">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>

            <Button fx:id="startButton" onAction="#start" styleClass="custom-start-button" text="START GAME"/>
            <Button fx:id="exitButton" onAction="#exitGame" styleClass="custom-exit-button" text="EXIT"/>

        </VBox>

        <!-- Footer -->
        <Label styleClass="footer-label" text="TEAM HHH STUDIO">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Label>
    </VBox>
</StackPane>
